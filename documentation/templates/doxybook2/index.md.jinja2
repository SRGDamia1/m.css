{% import "macros.md.jinja2" as macros %}
{% macro render_entries(entries, indent=0) %}
{% for child in entries %}
{# {{ ' ' * indent }}- **{{ child.kind }}** {{ macros.linked_name(child) }}{% if macros.exists(child.brief_markdown) == "true" %} — {{ child.brief_markdown }}{% endif %}{{ '\n' }} #}
{{ ' ' * indent }}- {{ macros.linked_name(child) }}{% if macros.exists(child.brief_markdown) == "true" %} — {{ child.brief_markdown|trim }}{% endif +%}
{% if macros.exists(child.children) == "true" %}{{ render_entries(child.children, indent + 2) }}{% endif %}
{% endfor %}
{% endmacro %}
{{ render_entries(children) }}
