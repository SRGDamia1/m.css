    (macros.exists(compound.tests) == "true") or
    (macros.exists(compound.todos) == "true") or
    (macros.exists(compound.pre) == "true") or
    (macros.exists(compound.post) == "true") or
    (macros.exists(compound.copyright) == "true") or
    (macros.exists(compound.invariant) == "true")
) %}
{{ macros.render_if_exists(compound.description_markdown) }}
{% if has_metadata %}

