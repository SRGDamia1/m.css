{% import "macros.md.jinja2" as macros %}
{% set has_metadata = (
    (macros.exists(compound.params) == "true" and compound.has_param_details) or
    (macros.exists(compound.return_values) == "true") or
    (macros.exists(compound.exceptions) == "true") or
    compound.has_template_details or
    (macros.exists(compound.deprecated) == "true") or
    (macros.exists(compound.return_value) == "true") or
    (macros.exists(compound.authors) == "true") or
    (macros.exists(compound.version) == "true") or
    (macros.exists(compound.since) == "true") or
    (macros.exists(compound.date) == "true") or
    (macros.exists(compound.note) == "true") or
